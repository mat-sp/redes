{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "redlab-x49",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "vars": {"ALLOWED_ORIGINS": "https://mat-sp.github.io"},
  "durable_objects": {"bindings": [{"name": "ROOMS", "class_name": "RedLabRoom"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["RedLabRoom"]}],
  "assets": {"directory": "./docs", "binding": "ASSETS", "run_worker_first": true},
  "observability": {"enabled": false}
}
